<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sap Solar</title>
<meta name="description" content="My channel and my networks, all in one place.">
<meta name="theme-color" content="#c9b0ef">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..700&family=Outfit:wght@400..600&display=swap">
<style>
html, body { margin: 0; padding: 0; background: #c9b0ef; color: #2d1b4e; }
.liana * { pointer-events: none; }
.liana a, .liana a * { pointer-events: auto; }
.liana,
.liana *,
.liana *::before,
.liana *::after {
  box-sizing: border-box;
}

.liana {
  --bg: #c9b0ef;
  --fg: #2d1b4e;
  --muted: #614a86;
  --card: #f6f1ff;
  --card-fg: #2d1b4e;
  --accent: #6e3cc9;
  --accent-fg: #f7f3ff;
  --line: rgba(45, 27, 78, 0.16);
  --glow: rgba(126, 78, 214, 0.38);
  position: relative;
  min-height: 100dvh;
  background: var(--bg);
  color: var(--fg);
  font-family: Outfit, system-ui, sans-serif;
  color-scheme: dark;
}

.liana[data-light="true"] {
  color-scheme: light;
}

.liana a:link,
.liana a:visited {
  color: inherit;
  text-decoration: none;
}

.liana-glow,
.liana-grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.liana-glow {
  background: radial-gradient(ellipse 92% 46% at 50% -10%, var(--glow), transparent 68%);
}

.liana-grain {
  opacity: 0.22;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
}

.liana-col {
  position: relative;
  z-index: 1;
  width: min(100%, 28rem);
  margin: 0 auto;
  padding: 4.5rem 1.25rem 6.5rem;
  text-align: center;
}

.liana-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 6.5rem;
  height: 6.5rem;
  border-radius: 999px;
  object-fit: cover;
  border: 2px solid color-mix(in srgb, var(--accent) 72%, transparent);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
}

.avatar-fallback {
  display: grid;
  place-items: center;
  background: color-mix(in srgb, var(--accent) 24%, var(--bg));
  color: var(--fg);
  font-family: Fraunces, Georgia, serif;
  font-size: 2.5rem;
  font-weight: 560;
  letter-spacing: -0.04em;
}

.liana-name {
  margin: 0.9rem 0 0;
  font-family: Fraunces, Georgia, serif;
  font-weight: 560;
  font-size: clamp(1.85rem, 5vw, 2.2rem);
  letter-spacing: -0.035em;
  line-height: 1.12;
  text-wrap: balance;
}

.liana-handle {
  margin: 0.35rem 0 0;
  color: var(--muted);
  font-size: 0.95rem;
  font-weight: 500;
}

.liana-bio {
  margin: 0.75rem 0 0;
  max-width: 26rem;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  text-wrap: balance;
}

.liana-socials {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.65rem;
  margin-top: 1.15rem;
}

.social-btn {
  width: 2.75rem;
  height: 2.75rem;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: color-mix(in srgb, var(--fg) 7%, transparent);
  color: var(--fg);
  scale: 1;
  transition: scale 260ms cubic-bezier(0.22, 1, 0.36, 1), background-color 180ms ease;
}

.social-btn svg {
  width: 1.15rem;
  height: 1.15rem;
  display: block;
}

.social-btn:hover,
.social-btn:focus-visible {
  scale: 1.14;
  background: color-mix(in srgb, var(--fg) 14%, transparent);
}

.social-btn:active {
  scale: 0.96;
}

.link-stack {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  margin-top: 1.35rem;
}

.link-btn {
  display: block;
  position: relative;
  min-height: 3.65rem;
  padding: 0.55rem 1rem;
  border: 1px solid transparent;
  color: var(--fg);
  scale: 1;
  translate: 0 0;
  -webkit-tap-highlight-color: transparent;
  transition:
    scale 300ms cubic-bezier(0.22, 1, 0.36, 1),
    translate 300ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 300ms ease,
    background-color 180ms ease;
}

.link-btn-in {
  display: grid;
  grid-template-columns: 1.75rem minmax(0, 1fr) 1.75rem;
  align-items: center;
  min-height: 2.4rem;
  width: 100%;
}

.liana[data-shape="pill"] .link-btn {
  border-radius: 999px;
}

.liana[data-shape="rounded"] .link-btn {
  border-radius: 1.1rem;
}

.liana[data-shape="sharp"] .link-btn {
  border-radius: 0.45rem;
}

.liana[data-fill="solid"] .link-btn:not(.is-feature):not(.is-draft) {
  background: var(--card);
  color: var(--card-fg);
  box-shadow: 0 1px 0 color-mix(in srgb, var(--fg) 10%, transparent);
}

.liana[data-fill="outline"] .link-btn:not(.is-feature):not(.is-draft) {
  background: transparent;
  border-color: var(--line);
}

.liana[data-fill="glass"] .link-btn:not(.is-feature):not(.is-draft) {
  background: color-mix(in srgb, var(--fg) 8%, transparent);
  border-color: var(--line);
  backdrop-filter: blur(10px);
}

.liana .link-btn.is-feature {
  background: var(--accent);
  color: var(--accent-fg);
  border-color: transparent;
  box-shadow: 0 10px 26px color-mix(in srgb, var(--accent) 32%, transparent);
}

.liana a.link-btn.is-feature:link,
.liana a.link-btn.is-feature:visited {
  color: var(--accent-fg);
}

.liana .link-btn.is-draft {
  background: transparent;
  color: var(--fg);
  border: 1px dashed var(--line);
  box-shadow: none;
  opacity: 0.55;
}

.link-ico,
.link-go {
  display: grid;
  place-items: center;
  color: var(--muted);
}

.link-btn.is-feature .link-ico,
.link-btn.is-feature .link-go {
  color: var(--accent-fg);
}

.link-ico svg {
  width: 1.2rem;
  height: 1.2rem;
  display: block;
}

.link-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-size: 1rem;
  font-weight: 560;
  letter-spacing: -0.01em;
}

.link-go {
  opacity: 0.35;
  translate: -4px 0;
  transition:
    opacity 200ms ease,
    translate 300ms cubic-bezier(0.22, 1, 0.36, 1);
}

.link-go::before {
  content: "";
  width: 0.45rem;
  height: 0.45rem;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  rotate: 45deg;
}

.link-stack:has(.link-btn:hover) .link-btn:not(:hover),
.link-stack:has(.link-btn:focus-visible) .link-btn:not(:focus-visible):not(:hover) {
  scale: 0.975;
}

.link-btn:hover,
.link-btn:focus-visible {
  scale: 1.055;
  translate: 0 -3px;
  z-index: 2;
  box-shadow: 0 18px 34px rgba(0, 0, 0, 0.28);
}

.link-btn.is-feature:hover,
.link-btn.is-feature:focus-visible {
  box-shadow: 0 18px 36px color-mix(in srgb, var(--accent) 46%, transparent);
}

.link-btn:hover .link-go,
.link-btn:focus-visible .link-go {
  opacity: 1;
  translate: 0 0;
}

.link-btn:active {
  scale: 0.96;
  translate: 0 0;
}

.link-btn:focus-visible,
.social-btn:focus-visible,
.edit-launch:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.liana-empty {
  margin: 1.5rem 0 0;
  color: var(--muted);
  font-size: 0.95rem;
}

.edit-launch {
  position: fixed;
  z-index: 15;
  top: calc(0.85rem + env(safe-area-inset-top));
  right: 0.85rem;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  height: 2.75rem;
  padding: 0 1rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: color-mix(in srgb, var(--bg) 78%, transparent);
  color: var(--fg);
  backdrop-filter: blur(14px);
  font: 600 0.9rem/1 Outfit, system-ui, sans-serif;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
  -webkit-tap-highlight-color: transparent;
}

.edit-launch:active {
  scale: 0.96;
}

.edit-launch svg {
  width: 1.05rem;
  height: 1.05rem;
}

@media (min-width: 960px) {
  .liana-col {
    padding-top: 3.5rem;
    padding-bottom: 3rem;
  }

  .edit-launch {
    display: none;
  }
}

@media (prefers-reduced-motion: no-preference) {
  .rise {
    animation: liana-rise 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
}

@keyframes liana-rise {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .link-btn,
  .social-btn,
  .link-go,
  .edit-launch {
    transition: none;
  }

  .link-stack:has(.link-btn:hover) .link-btn,
  .link-btn:hover,
  .link-btn:active,
  .social-btn:hover,
  .social-btn:active {
    scale: 1;
    translate: 0 0;
  }
}

</style>
</head>
